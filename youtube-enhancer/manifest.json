{
  "manifest_version": 3,
  "name": "YouTube Enhancer",
  "version": "1.0.2",
  "description": "Enhances YouTube with additional features.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "features/vidplayer.js",
        "features/subs-comment.js",
        "features/shortsblock.js",
        "features/thumbnails.js",
        "content.js"
      ],
      "css": [
        "features/vidplayer.css",
        "features/subs-comment.css",
        "features/shortsblock.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "features/vidplayer.css",
        "features/subs-comment.css",
        "features/shortsblock.css"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
